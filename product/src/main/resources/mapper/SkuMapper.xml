<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ysh.b2cmall.product.dao.mapper.SkuMapper">

    <resultMap id="SkuResultMap" type="com.ysh.b2cmall.product.dao.po.SkuPO">
        <id property="id" column="id"/>
        <result property="shopId" column="shop_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="price" column="price"/>
        <result property="stock" column="stock"/>
        <result property="type" column="type"/>
        <result property="images" column="images"/>
        <result property="spec" column="spec"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tb_sku (shop_id, category_id, name, description, price, stock, type, images, spec, status)
        VALUES (#{shopId}, #{categoryId}, #{name}, #{description}, #{price}, #{stock}, #{type}, #{images}, #{spec}, #{status})
    </insert>

    <select id="selectById" resultMap="SkuResultMap">
        SELECT * FROM tb_sku WHERE id = #{id}
    </select>

    <update id="updateStatus">
        UPDATE tb_sku SET status = #{status}, updated_at = CURRENT_TIMESTAMP WHERE id = #{id}
    </update>

</mapper>
