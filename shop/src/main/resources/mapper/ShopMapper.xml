<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ysh.b2cmall.shop.dao.mapper.ShopMapper">

    <resultMap id="ShopResultMap" type="com.ysh.b2cmall.shop.dao.po.ShopPO">
        <id property="id" column="id"/>
        <result property="shopName" column="shop_name"/>
        <result property="adminAccount" column="admin_account"/>
        <result property="adminPassword" column="admin_password"/>
        <result property="logoUrl" column="logo_url"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="registerShop" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tb_shop (shop_name, admin_account, admin_password, logo_url, status)
        VALUES (#{shopName}, #{adminAccount}, #{adminPassword}, #{logoUrl}, #{status})
    </insert>

    <select id="exist" resultType="int">
        SELECT COUNT(*) FROM tb_shop WHERE shop_name = #{shopName}
    </select>

    <select id="selectById" resultMap="ShopResultMap">
        SELECT * FROM tb_shop WHERE id = #{id}
    </select>

    <select id="findByShopNameAndAccount" resultMap="ShopResultMap">
        SELECT * FROM tb_shop
        WHERE shop_name = #{shopName} AND admin_account = #{adminAccount}
        LIMIT 1
    </select>

</mapper>
